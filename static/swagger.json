    "/msvision": {
      "post": {
        "tags": [
        ],
        "summary": "Use Microsoft Vision to create caption of image",
        
        "description": "You must refer to jpegs for this to work properly from Alfresco despite vision allowing other formats\nThis uses microsoft/florence-2-base by default",
       
        "produces": [
          "application/json"
        ],
        
        "parameters": [
          {
            "name": "prompt and image",
            "in": "body",
            "description": "example:  {\"prompt\":\"\\<CAPTION\\>\",\"image\":\"https://www.stockvault.net/data/2020/01/25/272807/preview16.jpg\"}\nYou can use \\<OD\\> to get labels and boundary boxes\nuse \\<MORE_DETAILED_CAPTION\\> to get better caption detail\nmore info: https://huggingface.co/microsoft/Florence-2-base",
            "required": true,
